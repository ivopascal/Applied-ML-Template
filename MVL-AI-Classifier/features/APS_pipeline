class AzimuthalPowerSpectrumPreprocessor(BasePreprocessor):
    """
    Compute a median-based azimuthal (radial) power spectrum from an RGB patch.

    Pipeline:
        RGB -> normalize -> grayscale -> DC removal -> Hann window
        -> FFT2 -> power spectrum -> radial binning (median) -> log transform

    Output:
        np.ndarray of shape (n_bins,), dtype float64.
        Values are log-transformed median power per radial frequency bin.
    """

    def __init__(
        self,
        n_bins: int,
        epsilon: float = DEFAULT_EPSILON,
    ):
        if not isinstance(n_bins, (int, np.integer)) or n_bins <= 0:
            raise ValueError("n_bins must be a positive integer.")

        self.n_bins = int(n_bins)
        self.epsilon = epsilon

        self._normalization = RGBNormalizationPreprocessor(epsilon=epsilon)
        # No unit-range normalization needed: DC removal handles centering.
        self._to_gray = RGBToGrayPreprocessor(normalize=False, epsilon=epsilon)

        # Precompute the 2D Hann window (fixed patch size).
        w = np.hanning(PATCH_SIZE)
        self._window_2d = np.outer(w, w)

        # Precompute radial distance map and bin assignments.
        self._bin_idx = self._build_bin_index()

    def _build_bin_index(self) -> np.ndarray:
        """
        Precompute a flat array mapping each FFT coefficient to a radial bin.

        Returns
        -------
        np.ndarray of shape (PATCH_SIZE * PATCH_SIZE,), dtype int32.
        """
        cx = cy = PATCH_SIZE // 2  # 128

        y, x = np.meshgrid(
            np.arange(PATCH_SIZE),
            np.arange(PATCH_SIZE),
            indexing="ij",
        )
        r = np.sqrt((x - cx) ** 2 + (y - cy) ** 2)
        r_max = r.max()

        bin_edges = np.linspace(0.0, r_max, self.n_bins + 1)

        bin_idx = np.digitize(r.ravel(), bin_edges, right=False) - 1
        bin_idx = np.clip(bin_idx, 0, self.n_bins - 1).astype(np.int32)
        return bin_idx

    def __call__(self, image_patch: np.ndarray) -> np.ndarray:
        image = self._normalization(image_patch)
        gray = self._to_gray(image)

        # Remove DC component and apply Hann window to reduce spectral leakage.
        gray_windowed = (gray - gray.mean()) * self._window_2d

        # Compute 2D power spectrum.
        F_shifted = np.fft.fftshift(np.fft.fft2(gray_windowed))
        power_flat = (np.abs(F_shifted) ** 2).ravel()

        # Vectorized median per radial bin via argsort + searchsorted.
        # Sort power values by bin assignment.
        order = np.argsort(self._bin_idx, kind="stable")
        sorted_bins = self._bin_idx[order]
        sorted_power = power_flat[order]

        # Find the start index of each bin using searchsorted.
        bin_starts = np.searchsorted(sorted_bins, np.arange(self.n_bins))
        bin_ends = np.searchsorted(sorted_bins, np.arange(self.n_bins), side="right")

        spectrum = np.zeros(self.n_bins, dtype=np.float64)
        for b in range(self.n_bins):
            s, e = bin_starts[b], bin_ends[b]
            if s < e:
                spectrum[b] = np.median(sorted_power[s:e])
            # else: leave as 0.0 (rare edge case near outer frequency boundary)

        return np.log(spectrum + self.epsilon)



