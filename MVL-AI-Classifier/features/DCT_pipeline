import numpy as np
from scipy.fft import dctn

from features.base import BasePreprocessor
from features.constants import (
    DEFAULT_EPSILON,
    JPEG_BLOCK_SIZE,
    JPEG_BLOCKS_PER_DIM,
    JPEG_RECENTER_VALUE,
    PATCH_SIZE,
)
from features.RGB_normalization_pipeline import RGBNormalizationPreprocessor

class DCTDistributionPreprocessor(BasePreprocessor):
    """
    Per-channel distributional statistics of JPEG block DCT-II coefficients.

    Output
    ------
    np.ndarray of shape (3, 4, JPEG_BLOCK_SIZE, JPEG_BLOCK_SIZE), float32.
        axis 0 : R, G, B channels.
        axis 1 : statistic index [robust_dispersion, kurtosis, sparsity, sign_asym].
        axes 2–3 : DCT frequency position (u, v).

    """

    def __init__(
        self,
        epsilon: float = DEFAULT_EPSILON,
        sparsity_threshold: float = 0.10,
        log_compress_dispersion: bool = True,
    ):
        """
        Parameters
        ----------
        epsilon : float
            Numerical stability constant for division and log.
        sparsity_threshold : float
            Fraction of per-channel AC RMS used as the near-zero threshold.
            Scale-invariant: 0.10 means "below 10% of the image's own AC
            energy". Must be positive.
        log_compress_dispersion : bool
            If True, apply log(x + epsilon) to the MAD map (index 0) only.
            MAD is strictly non-negative with wide dynamic range. Kurtosis
            (signed), sparsity ([0, 1]), and sign_asym ([-1, 1]) have bounded
            or signed ranges that do not benefit from log compression and are
            left untransformed.
        """

        if sparsity_threshold <= 0:
            raise ValueError("sparsity_threshold must be positive.")

        self.epsilon = np.float32(epsilon)
        self.sparsity_threshold = np.float32(sparsity_threshold)
        self.log_compress_dispersion = bool(log_compress_dispersion)
        self._normalization = RGBNormalizationPreprocessor()

    def _extract_blocks(self, image: np.ndarray) -> np.ndarray:
        """
        Partition a (PATCH_SIZE, PATCH_SIZE, 3) image into non-overlapping
        8×8 blocks without Python-level loops.

        Shape validation is intentionally omitted: RGBNormalizationPreprocessor
        already guarantees (PATCH_SIZE, PATCH_SIZE, 3) float32. The module-level
        assert covers the PATCH_SIZE % JPEG_BLOCK_SIZE invariant at import time.

        Returns
        -------
        np.ndarray of shape (3, JPEG_BLOCKS_PER_DIM², JPEG_BLOCK_SIZE,
                             JPEG_BLOCK_SIZE), float32, C-contiguous.
        """
        n  = JPEG_BLOCKS_PER_DIM   # 32
        bs = JPEG_BLOCK_SIZE       # 8

        # (H, W, C)
        # → (n, bs, n, bs, C)   split spatial dims into (block_grid, block_pixels)
        # → (C, n, n, bs, bs)   channel-first
        # → (C, n*n, bs, bs)    flatten block grid into a single block index
        blocks = (
            image
            .reshape(n, bs, n, bs, 3)
            .transpose(4, 0, 2, 1, 3)
            .reshape(3, n * n, bs, bs)
        )
        # transpose produces a non-contiguous view; ascontiguousarray ensures
        # dctn operates on cache-friendly memory without an internal copy.
        return np.ascontiguousarray(blocks, dtype=np.float32)

    def _unbiased_excess_kurtosis(self, x: np.ndarray) -> np.ndarray:
        """
        Unbiased Fisher excess kurtosis along the block axis (axis=1),
        fully vectorised over all (channel, u, v) positions via np.where.

        Equivalent to scipy.stats.kurtosis(x, axis=1, fisher=True, bias=False)
        but implemented in pure numpy, avoiding the per-call overhead of the
        scipy implementation on large batched arrays.

        Parameters
        ----------
        x : np.ndarray of shape (3, n_blocks, 8, 8).

        Returns
        -------
        np.ndarray of shape (3, 8, 8), float32.
            Positions with near-zero variance are set to 0.0.
        """
        n  = x.shape[1]   # 1024 blocks
        mu = x.mean(axis=1, keepdims=True)
        d  = x - mu

        m2 = (d * d).mean(axis=1)          # biased 2nd central moment
        m4 = (d * d * d * d).mean(axis=1)  # biased 4th central moment

        # Unbiased excess kurtosis:
        # G2 = (n-1)/((n-2)(n-3)) * ((n+1)*m4/m2^2 - 3*(n-1))
        # Derivation: expand g2 = m4/m2^2 - 3 into the standard bias-corrected
        # formula G2 = (n-1)/((n-2)(n-3)) * ((n+1)*g2 + 6).
        correction = np.float32((n - 1) / ((n - 2) * (n - 3)))
        kurt = np.where(
            m2 > self.epsilon,
            correction * (
                np.float32(n + 1) * m4 / (m2 * m2 + self.epsilon)
                - np.float32(3 * (n - 1))
            ),
            np.float32(0.0),
        ).astype(np.float32)

        return np.nan_to_num(kurt, nan=0.0, posinf=0.0, neginf=0.0)


    def __call__(self, image_patch: np.ndarray) -> np.ndarray:
        """
        Parameters
        ----------
        image_patch : np.ndarray of shape (PATCH_SIZE, PATCH_SIZE, 3),
                      uint8 or float32 in [0, 255].

        Returns
        -------
        np.ndarray of shape (3, 4, JPEG_BLOCK_SIZE, JPEG_BLOCK_SIZE), float32.
        """
        # Step 1 – validate and cast to float32 in [0, 255].
        image = self._normalization(image_patch)

        # Step 2 – JPEG-style level shift: centre [0, 255] around zero.
        # RGBNormalizationPreprocessor outputs float32 in [0, 255] (it casts
        # dtype but does not divide by 255), so this maps to ≈ [-128, 127].
        image_centered = image - np.float32(JPEG_RECENTER_VALUE)

        # Step 3 – extract non-overlapping 8×8 blocks: (3, 1024, 8, 8).
        blocks = self._extract_blocks(image_centered)

        # Step 4 – 2-D DCT-II, vectorised across all blocks and channels.
        # norm="ortho" preserves energy (Parseval equality) and keeps
        # coefficient magnitudes comparable across (u, v) positions.
        dct_blocks = dctn(blocks, axes=(-2, -1), norm="ortho").astype(np.float32)

        # Step 5 – zero the DC coefficient before all statistics.
        # DC encodes mean block brightness, already represented by the APS
        # low-frequency bins. Removing it prevents DC from dominating every
        # downstream statistic and avoids degenerate kurtosis at (0, 0).
        dct_blocks[:, :, 0, 0] = np.float32(0.0)

        abs_dct = np.abs(dct_blocks)

        # ------------------------------------------------------------------
        # Statistic A – robust dispersion (MAD across blocks)
        # median(|x − median(x)|) is robust to outlier blocks while remaining
        # non-redundant with APS, which only captures global mean energy.
        # ------------------------------------------------------------------
        block_median     = np.median(dct_blocks, axis=1, keepdims=True)
        robust_dispersion = np.median(
            np.abs(dct_blocks - block_median), axis=1
        ).astype(np.float32)

        # ------------------------------------------------------------------
        # Statistic B – unbiased excess kurtosis across blocks.
        # Tail weight of the per-position coefficient distribution.
        # ------------------------------------------------------------------
        kurt = self._unbiased_excess_kurtosis(dct_blocks)

        # ------------------------------------------------------------------
        # Statistic C – scale-invariant sparsity.
        # Normalise by per-channel AC RMS: a single global scalar per channel.
        # This is scale-invariant across JPEG quality settings (contrast the
        # previous per-position local_median normaliser, which collapsed the
        # statistic toward a near-constant for all images).
        # Structural independence from robust_dispersion: MAD encodes
        # per-position distribution shape; the RMS normaliser here is a global
        # channel-level energy scalar — the two statistics cannot be derived
        # from each other.
        # DC is already 0 and occupies 1 of 64 × 1024 positions; its
        # contribution to the RMS is negligible (< 2%).
        # ------------------------------------------------------------------
        ac_rms = np.sqrt(
            (dct_blocks ** 2).mean(axis=(1, 2, 3), keepdims=True) + self.epsilon
        )  # shape: (3, 1, 1, 1)
        sparse = (
            abs_dct < (self.sparsity_threshold * ac_rms)
        ).mean(axis=1).astype(np.float32)

        # ------------------------------------------------------------------
        # Statistic D – sign asymmetry across blocks.
        # Signed directional bias. Natural textures tend toward symmetry.
        # Range [-1, 1]; no log applied.
        # ------------------------------------------------------------------
        sign_asym = (
            (dct_blocks > 0).mean(axis=1) - (dct_blocks < 0).mean(axis=1)
        ).astype(np.float32)

        # Step 6 – stack into output tensor: (3, 4, 8, 8).
        features = np.stack(
            [robust_dispersion, kurt, sparse, sign_asym],
            axis=1,
        ).astype(np.float32)

        # Step 7 – zero the DC output slot explicitly.
        # All statistics at (0, 0) are already 0 because dct_blocks[:, :, 0, 0]
        # was zeroed. This assignment is a defensive convention that prevents
        # floating-point residuals from leaking into downstream model inputs.
        features[:, :, 0, 0] = np.float32(0.0)

        # Step 8 – optional log compression for the dispersion map only.
        # robust_dispersion is strictly non-negative with wide dynamic range.
        # Uses log(x + epsilon) for consistency with APS and NoiseResiduals
        # (not log1p, which has an implicit epsilon of 1.0).
        if self.log_compress_dispersion:
            features[:, 0] = np.log(features[:, 0] + self.epsilon)

        return features
