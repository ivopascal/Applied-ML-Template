class DCTPreprocessor(BasePreprocessor):
    """
    Compute per-channel DCT-II coefficient standard deviation maps from an
    RGB patch.

    Output
    ------
    np.ndarray of shape (3, JPEG_BLOCK_SIZE, JPEG_BLOCK_SIZE), dtype float32.
        axis 0 : R, G, B channels.
        axes 1–2 : std of DCT[u, v] across all JPEG_BLOCKS_PER_DIM² blocks,
                   optionally log-transformed.
    """

    def __call__(self, image_patch: np.ndarray) -> np.ndarray:
        """
        Parameters
        ----------
        image_patch : np.ndarray of shape (PATCH_SIZE, PATCH_SIZE, 3),
                      uint8 or float32.

        Returns
        -------
        np.ndarray of shape (3, JPEG_BLOCK_SIZE, JPEG_BLOCK_SIZE), float32.
        """
        # Step 1 – validate and cast to float32 in [0, 1]
        image = self._normalization(image_patch)
        image_255 = image * np.float32(255.0)

        # Step 2 – JPEG-style level shift: centre dynamic range before DCT
        image_centered = image_255 - np.float32(JPEG_RECENTER_VALUE)  # ≈ [-128, 127]

        # Step 3 – extract all 8×8 blocks: (3, 1024, 8, 8)
        blocks = self._extract_blocks(image_centered)

        # Step 4 – 2-D DCT-II, vectorised over all blocks and channels
        dct_blocks = dctn(blocks, axes=(-2, -1), norm="ortho")
        # shape: (3, JPEG_BLOCKS_PER_DIM², JPEG_BLOCK_SIZE, JPEG_BLOCK_SIZE)

        # Step 5 – std of signed coefficients across blocks at each (u, v).
        #          ddof=1: unbiased estimator.
        #          Signed (not |·|) so the std reflects true coefficient spread,
        #          not conflated magnitude. This is the key change from mean |·|:
        #          std is not reconstructible from any global average → orthogonal to APS.
        std_dct = np.std(dct_blocks, axis=1, ddof=1).astype(np.float32)
        # shape: (3, JPEG_BLOCK_SIZE, JPEG_BLOCK_SIZE)

        # Step 6 – optional log-compression
        if self.log_scale:
            return np.log(std_dct + self.epsilon).astype(np.float32)

        return std_dct
