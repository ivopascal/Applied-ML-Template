import numpy as np
from scipy.fft import dctn
from scipy.stats import kurtosis

from features.base import BasePreprocessor
from features.constants import (
    JPEG_BLOCK_SIZE,
    JPEG_RECENTER_VALUE,
    DEFAULT_EPSILON,
)
from features.RGB_normalization_pipeline import RGBNormalizationPreprocessor


class DCTDistributionPreprocessor(BasePreprocessor):
    """
    Distribution-focused JPEG-DCT statistics designed to be minimally
    redundant with APS.
    This pipeline captures:
        - coefficient sparsity
        - heavy-tail behavior
        - directional asymmetry
        - local blockwise distribution structure
        - chromatic frequency inconsistencies

    Output
    ------
    np.ndarray of shape (3, 4, 8, 8), float32

    Statistics per coefficient:
        [0] mean absolute deviation
        [1] kurtosis
        [2] sparsity ratio
        [3] sign asymmetry
    """

    def __init__(
        self,
        epsilon: float = DEFAULT_EPSILON,
        sparsity_threshold: float = 2.0,
        log_scale: bool = True,
    ):
        self.epsilon = np.float32(epsilon)
        self.sparsity_threshold = np.float32(sparsity_threshold)
        self.log_scale = log_scale

        self._normalization = RGBNormalizationPreprocessor()

    def __call__(self, image_patch: np.ndarray) -> np.ndarray:

        # ------------------------------------------------------------
        # 1. Normalize to [0,255]
        # ------------------------------------------------------------

        image = self._normalization(image_patch)
        image = image.astype(np.float32) * np.float32(255.0)

        # JPEG recentering
        image -= np.float32(JPEG_RECENTER_VALUE)

        # ------------------------------------------------------------
        # 2. Extract non-overlapping 8x8 blocks
        # ------------------------------------------------------------

        blocks = self._extract_blocks(image)
        # shape:
        # (3, n_blocks, 8, 8)

        # ------------------------------------------------------------
        # 3. Batched orthonormal DCT-II
        # ------------------------------------------------------------

        dct_blocks = dctn(
            blocks,
            axes=(-2, -1),
            norm="ortho",
        ).astype(np.float32)

        # Remove DC coefficient entirely.
        # APS already captures global low-frequency energy strongly.
        dct_blocks[:, :, 0, 0] = 0.0

        # ------------------------------------------------------------
        # 4. Distribution statistics
        # ------------------------------------------------------------

        abs_dct = np.abs(dct_blocks)

        # ------------------------------------------------------------
        # A. Mean absolute deviation (robust energy proxy)
        # Less redundant than variance.
        # ------------------------------------------------------------

        mad = np.mean(abs_dct, axis=1)

        # ------------------------------------------------------------
        # B. Kurtosis
        # Captures heavy tails / unnatural coefficient distributions.
        # Very useful for synthetic artifacts.
        # ------------------------------------------------------------

        kurt = kurtosis(
            dct_blocks,
            axis=1,
            fisher=True,
            bias=False,
        ).astype(np.float32)

        # numerical cleanup
        kurt = np.nan_to_num(
            kurt,
            nan=0.0,
            posinf=0.0,
            neginf=0.0,
        )

        # ------------------------------------------------------------
        # C. Sparsity ratio
        # Fraction of near-zero coefficients.
        #
        # JPEG quantization and generative models often produce
        # abnormal sparsity patterns.
        # ------------------------------------------------------------

        sparse = (
            abs_dct < self.sparsity_threshold
        ).mean(axis=1).astype(np.float32)

        # ------------------------------------------------------------
        # D. Sign asymmetry
        #
        # Natural textures tend toward sign symmetry.
        # Some generators and compression artifacts do not.
        # ------------------------------------------------------------

        positive = (dct_blocks > 0).mean(axis=1)
        negative = (dct_blocks < 0).mean(axis=1)

        sign_asym = (positive - negative).astype(np.float32)

        # ------------------------------------------------------------
        # 5. Stack statistics
        # ------------------------------------------------------------

        features = np.stack(
            [
                mad,
                kurt,
                sparse,
                sign_asym,
            ],
            axis=1,
        ).astype(np.float32)

        # shape:
        # (3, 4, 8, 8)

        # ------------------------------------------------------------
        # 6. Optional compression
        # ------------------------------------------------------------

        if self.log_scale:

            # Only apply log to strictly positive statistics.
            features[:, 0] = np.log1p(features[:, 0])

            # kurtosis can be negative -> leave untouched
            # sign asymmetry signed -> leave untouched
            # sparsity already bounded [0,1]

        return features
