class GLCMPreprocessor(BasePreprocessor):
    """
    Compute normalized Gray-Level Co-occurrence Matrices (GLCMs) from a
    256x256 RGB image patch.

    Four spatial offsets are computed:
        horizontal   (dx=+1, dy= 0)
        vertical     (dx= 0, dy=+1)
        diagonal     (dx=+1, dy=+1)
        anti-diagonal(dx=-1, dy=+1)

    Parameters
    ----------
    n_levels : int
        Number of discrete gray levels for quantization.
    symmetric : bool
        If True, each GLCM is symmetrized (G = G + G.T), so that
        co-occurrence of (i, j) and (j, i) are treated as equivalent.
    epsilon : float
        Numerical stability constant.

    Output:
        np.ndarray of shape (4, n_levels, n_levels), dtype float64.
        Values are normalized co-occurrence probabilities.
        axis 0 order: [horizontal, vertical, diagonal, anti_diagonal]
    """

    _OFFSETS = [
        (1,  0),   # horizontal
        (0,  1),   # vertical
        (1,  1),   # diagonal
        (-1, 1),   # anti-diagonal
    ]

    def __init__(
        self,
        n_levels: int = 16,
        symmetric: bool = True,
        epsilon: float = DEFAULT_EPSILON,
    ):
        if not isinstance(n_levels, (int, np.integer)) or n_levels <= 0:
            raise ValueError("n_levels must be a positive integer.")

        self.n_levels = int(n_levels)
        self.symmetric = symmetric
        self.epsilon = epsilon

        self._normalization = RGBNormalizationPreprocessor(epsilon=epsilon)
        # normalize=True maps grayscale to [0, 1] for clean quantization.
        self._to_gray = RGBToGrayPreprocessor(normalize=True, epsilon=epsilon)

    def _compute_glcm(
        self,
        qimg: np.ndarray,
        dx: int,
        dy: int,
    ) -> np.ndarray:
        """
        Compute one normalized GLCM for a single spatial offset (dx, dy).

        reference pixel : (y, x)
        neighbor pixel  : (y + dy, x + dx)
        Only in-bounds pixel pairs are included.

        Returns
        -------
        np.ndarray of shape (n_levels, n_levels), dtype float64.
        """
        h, w = qimg.shape

        y_ref = slice(max(0, -dy),  h - max(0, dy))
        y_nb  = slice(max(0,  dy),  h - max(0, -dy))
        x_ref = slice(max(0, -dx),  w - max(0, dx))
        x_nb  = slice(max(0,  dx),  w - max(0, -dx))

        ref = qimg[y_ref, x_ref].ravel()
        nb  = qimg[y_nb,  x_nb ].ravel()

        G = np.zeros((self.n_levels, self.n_levels), dtype=np.float64)
        np.add.at(G, (ref, nb), 1.0)

        if self.symmetric:
            G = G + G.T

        total = G.sum()
        # Only normalize when there are counts; otherwise return zero matrix.
        if total > 0:
            G /= total

        return G

    def __call__(self, image_patch: np.ndarray) -> np.ndarray:
        image = self._normalization(image_patch)
        gray = self._to_gray(image)

        # Quantize [0, 1] grayscale into n_levels discrete bins.
        gray_q = np.floor(gray * self.n_levels).astype(np.int32)
        gray_q = np.clip(gray_q, 0, self.n_levels - 1)

        glcms = np.stack(
            [self._compute_glcm(gray_q, dx, dy) for dx, dy in self._OFFSETS],
            axis=0,
        )  # shape: (4, n_levels, n_levels)

        return glcms
